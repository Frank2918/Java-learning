# ==========================================
# 1. Java 编译产物 (最重要)
# ==========================================
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ==========================================
# 2. 构建工具输出目录 (如果以后用 Maven/Gradle)
# ==========================================
target/
build/
out/
bin/
.gradle/
!.mvn/wrapper/maven-wrapper.jar

# ==========================================
# 3. 编辑器与 IDE 配置文件 (VS Code / IDEA / Eclipse)
# ==========================================
# VS Code (如果你想让别人共用调试配置，可以改成 .vscode/*
.vscode/
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
# Eclipse
.settings/
.classpath
.project

# ==========================================
# 4. 系统与操作系统生成的文件
# ==========================================
# macOS
.DS_Store
# Windows
Thumbs.db
Desktop.ini

# ==========================================
# 5. 日志文件与临时文件
# ==========================================
*.log
*.tmp
*.bak

# ==========================================
# 6. 依赖与环境配置 (如果用到)
# ==========================================
node_modules/
.env
*.properties
!gradle-wrapper.properties